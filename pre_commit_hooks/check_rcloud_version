#!/usr/bin/env bash

# This hook replaces easily all related files where the rCloud version
# is mentioned.
# Date: 2020-08-11
# Update: 2026-09-18
# Author: Martina Rath
# Email: mpratscher@gmail.com

set -o pipefail

WORKDIR=$(pwd)
VERSION_FILE=VERSION
# Check the branch name
BRANCH_NAME=$(git --git-dir "${WORKDIR}/.git" branch | sed -ne 's/^\* \(.*\)/\1/p')
# Get only the version number of the branch
NEW_VERSION=${BRANCH_NAME#*rCloud}
PREV_VERSION=$(cat ${VERSION_FILE})

# A hack to solve the sed issue between Darwin and Linux
sedi() {
  case "$(uname -s)" in
    Darwin) sed -i '' "$@" ;;
    Linux)  sed -i "$@" ;;
    *)      echo "Unsupported OS: $(uname -s)" >&2; return 1 ;;
  esac
}

# Check if the branch name is called rCloudx.x.x
if ! echo "${BRANCH_NAME}" | grep -Eq "^rCloud[0-9]+\.[0-9]+\.[0-9]+$"; then
    echo "No branch with naming rCloudx.x.x found!"
    exit 0
fi

# Check if the VERSION_FILE exists and is not empty
if [ ! -f ${VERSION_FILE} ]  || [ ! -s ${VERSION_FILE} ]
then
    echo "Filename 'VERSION' not found OR is empty!"
    exit 0
fi

# Compare two semantic versions component-wise.
# Returns 0 if $1 is greater than $2, 1 otherwise.
version_gt() {
  local IFS=.
  local i a=($1) b=($2)
  for ((i = 0; i < 3; i++)); do
    if (( ${a[i]:-0} > ${b[i]:-0} )); then
      return 0
    elif (( ${a[i]:-0} < ${b[i]:-0} )); then
      return 1
    fi
  done
  return 1
}

# Check if the old version is higher than the new one
if version_gt "${PREV_VERSION}" "${NEW_VERSION}"; then
    echo "Old version (${PREV_VERSION}) can't be higher than the new version (${NEW_VERSION})!"
    exit 0
fi

# Check if the version is the same
if [ "${PREV_VERSION}" == "${NEW_VERSION}" ]; then
    echo "Skip - version is the same!"
    exit 0
fi

# Check if the templates dir exists
if [ ! -d templates ]; then
    echo "Directory templates doesn't exist!"
    exit 0
fi




echo "Replaced version ${PREV_VERSION} with ${NEW_VERSION} in these files:"
for file in $(grep -rl "Default: ${PREV_VERSION}" templates/)
do
    # Don't create a backup file
    sedi -e  "s/Default: ${PREV_VERSION}/Default: ${NEW_VERSION}/" $file
    echo "- ${file}"
done
# Write new version to VERSION file
echo "${NEW_VERSION}" > "${VERSION_FILE}"
echo "- ${VERSION_FILE}"

# Stage and commit the changed files
git add -u
git commit --no-verify -m "chore(release): bump rCloud version to ${NEW_VERSION}"
echo
echo "All changes have been committed."
echo
echo "# Push the changes:"
echo "  git push origin ${BRANCH_NAME}"
